bin/
_output/
_artifacts/
junit-report.xml

# gh-pages
/gh-pages

# IDEs and editors
**/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
**/.vscode/*
!**/.vscode/tasks.json
!**/.vscode/launch.json

# System Files
.DS_Store
Thumbs.db

# Dependencies, generated code, and test caches
node_modules/
dist/
coverage/
.nx/
*.tsbuildinfo
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
.ipynb_checkpoints/

# Local credentials and environment configuration
.env
.env.*
!.env.example
!.env.sample
.aws/
credentials.json
*.pem
*.key

# Local logs and temporary editor/runtime files
/artifacts/**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tmp
*.swp
*.swo
*~

# Recreated scenario files and machine-specific execution metadata
/artifacts/**/generated-scenarios/
/artifacts/**/run-metadata.txt

# Generated reports; methods and interpretation live in README.md
/artifacts/**/*.md
/results/*.md

# Local research working notes consolidated into README.md
/STATUS.md
/REPORT.md
/METHODOLOGY.md
/EXPERIMENTS.md
/REPRODUCTION.md
/REAL_AWS_PROFILING.md
/REAL_AWS_EXPERIMENTS.md
